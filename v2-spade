-- Auto Movement
local function getCurrentWaypoints()
    if patrolMode == "left"  then return leftWaypoints  end
    if patrolMode == "right" then return rightWaypoints end
    return {}
end

local function updatePatrol()
    if patrolMode == "none" then return end
    local c = LocalPlayer.Character; if not c then return end
    local rp = c:FindFirstChild("HumanoidRootPart"); if not rp then return end
    local wps = getCurrentWaypoints()
    if #wps == 0 then return end
    local tp  = wps[currentWaypoint]
    local txz = Vector3.new(tp.X, 0, tp.Z)
    local cxz = Vector3.new(rp.Position.X, 0, rp.Position.Z)
    local spd = currentWaypoint >= 3 and CARRY_SPEED or NORMAL_SPEED
    if (txz - cxz).Magnitude > 3 then
        local md = (txz - cxz).Unit
        rp.AssemblyLinearVelocity = Vector3.new(md.X * spd, rp.AssemblyLinearVelocity.Y, md.Z * spd)
    else
        if currentWaypoint == #wps then
            currentWaypoint = 1
            rp.AssemblyLinearVelocity = Vector3.new(0, rp.AssemblyLinearVelocity.Y, 0)
        else
            currentWaypoint = currentWaypoint + 1
        end
    end
end

