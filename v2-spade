    lbTxt.BackgroundTransparency = 1
    lbTxt.Text = lbl
    lbTxt.TextColor3 = C_DIM
    lbTxt.Font = Enum.Font.GothamBold
    lbTxt.TextSize = 12
    lbTxt.TextXAlignment = Enum.TextXAlignment.Left
    lbTxt.ZIndex = 4
