                    if vel.Magnitude > 5 then
                        local t = tick()
                        local perp = Vector3.new(-vel.Z, 0, vel.X).Unit
                        local jitter = math.sin(t * 8.3) * 0.018
                        hrp.AssemblyLinearVelocity = vel + perp * (vel.Magnitude * jitter)
